.amri-root {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    row-gap: 8px;
}

.amri-header {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 2px;
}

.amri-toolbar {
    flex-direction: row;
    column-gap: 6px;
}

.amri-toolbar-button {
    flex-grow: 1;
    height: 24px;
}

.amri-scroll {
    flex-grow: 1;
    min-height: 180px;
}

.amri-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
}

.amri-toggle {
    width: 20px;
    margin-right: 6px;
}

.amri-status {
    flex-direction: row;
    align-items: center;
    min-width: 154px;
    margin-right: 8px;
}

.amri-status-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.amri-status-label {
    min-width: 120px;
}

.amri-path-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-align: middle-left;
    white-space: normal;
}

.amri-footer {
    flex-direction: row;
    column-gap: 6px;
}

.amri-footer-button {
    flex-grow: 1;
    height: 26px;
}

.amri-footer-primary {
    -unity-font-style: bold;
}
